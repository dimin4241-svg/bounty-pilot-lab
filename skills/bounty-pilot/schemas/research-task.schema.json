{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dimin4241-svg/bounty-pilot-lab/blob/main/skills/bounty-pilot/schemas/research-task.schema.json",
  "title": "Bounty Pilot Lab research task",
  "description": "A source-grounded task. Security hypotheses are handed to Codex Cloud only after scope and research review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "task_type",
    "status",
    "created_at",
    "target",
    "scope",
    "repository",
    "component",
    "hypothesis",
    "root_cause",
    "exploit_scenario",
    "source_basis",
    "attacker",
    "impact",
    "known_issue_review",
    "test_plan",
    "expected_test_result",
    "acceptance_criteria",
    "execution_constraints"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^BP-[A-Z0-9][A-Z0-9._-]{2,63}$"
    },
    "task_type": {
      "enum": [
        "security_hypothesis",
        "workflow_smoke_test"
      ]
    },
    "status": {
      "enum": [
        "HYPOTHESIS",
        "READY_FOR_POC",
        "TESTING",
        "CONFIRMED",
        "REFUTED",
        "INCONCLUSIVE",
        "OUT_OF_SCOPE"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "scope_status"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "program_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "scope_status": {
          "enum": [
            "in_scope",
            "unknown",
            "synthetic"
          ]
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "in_scope",
        "out_of_scope"
      ],
      "properties": {
        "in_scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "ref",
        "commit_sha"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40,64}$"
        }
      }
    },
    "component": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis": {
      "type": "string",
      "minLength": 20
    },
    "root_cause": {
      "type": "string",
      "minLength": 20
    },
    "exploit_scenario": {
      "type": "string",
      "minLength": 20
    },
    "source_basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "line_start",
          "line_end",
          "excerpt"
        ],
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "line_start": {
            "type": "integer",
            "minimum": 1
          },
          "line_end": {
            "type": "integer",
            "minimum": 1
          },
          "excerpt": {
            "type": "string",
            "minLength": 8
          }
        }
      }
    },
    "attacker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities",
        "reachable"
      ],
      "properties": {
        "capabilities": {
          "type": "string",
          "minLength": 1
        },
        "reachable": {
          "type": "boolean"
        }
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assets_or_rights",
        "impact_path",
        "estimated_loss"
      ],
      "properties": {
        "assets_or_rights": {
          "type": "string",
          "minLength": 1
        },
        "impact_path": {
          "type": "string",
          "minLength": 1
        },
        "estimated_loss": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "known_issue_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sources",
        "rationale"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "complete",
            "not_available"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "test_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate",
        "negative_control",
        "runner",
        "expected_test_count"
      ],
      "properties": {
        "candidate": {
          "type": "string",
          "minLength": 1
        },
        "negative_control": {
          "type": "string",
          "minLength": 1
        },
        "runner": {
          "type": "string",
          "minLength": 1
        },
        "expected_test_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "expected_test_result": {
      "type": "string",
      "minLength": 10
    },
    "acceptance_criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirm",
        "refute"
      ],
      "properties": {
        "confirm": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "refute": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "execution_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_mode",
        "network_access",
        "mainnet",
        "live_transactions",
        "production_writes",
        "third_party_users"
      ],
      "properties": {
        "run_mode": {
          "enum": [
            "local_simulation",
            "local_fork"
          ]
        },
        "network_access": {
          "enum": [
            "disabled",
            "package_managers_only"
          ]
        },
        "mainnet": {
          "const": false
        },
        "live_transactions": {
          "const": false
        },
        "production_writes": {
          "const": false
        },
        "third_party_users": {
          "const": false
        }
      }
    }
  }
}
