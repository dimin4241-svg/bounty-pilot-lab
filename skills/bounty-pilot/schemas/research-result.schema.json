{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dimin4241-svg/bounty-pilot-lab/blob/main/skills/bounty-pilot/schemas/research-result.schema.json",
  "title": "Bounty Pilot Lab research result",
  "description": "Cloud execution receipt bound to a task and commit. CONFIRMED and REFUTED require independently reviewed paired evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "status",
    "executor",
    "repository",
    "summary",
    "execution",
    "artifacts",
    "independent_review"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "pattern": "^BP-[A-Z0-9][A-Z0-9._-]{2,63}$"
    },
    "status": {
      "enum": [
        "HYPOTHESIS",
        "READY_FOR_POC",
        "TESTING",
        "CONFIRMED",
        "REFUTED",
        "INCONCLUSIVE",
        "OUT_OF_SCOPE"
      ]
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "model",
        "environment",
        "task_url"
      ],
      "properties": {
        "platform": {
          "const": "codex-cloud"
        },
        "model": {
          "const": "gpt-6-luna"
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "task_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "ref",
        "commit_sha"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40,64}$"
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "exit_code",
        "tests_run",
        "tests_passed",
        "bug_demonstrated",
        "assertions",
        "log_path",
        "log_sha256"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "tests_run": {
          "type": "integer",
          "minimum": 0
        },
        "tests_passed": {
          "type": "integer",
          "minimum": 0
        },
        "bug_demonstrated": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "assertions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "log_path": {
          "type": "string",
          "minLength": 1
        },
        "log_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "path",
          "sha256"
        ],
        "properties": {
          "kind": {
            "enum": [
              "test_log",
              "proof_of_concept",
              "supporting_evidence"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "independent_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewed_by",
        "reviewed_at",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "supports_finding",
            "supports_refutation",
            "inconclusive"
          ]
        },
        "reviewed_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "command",
        "exit_code",
        "output"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "output": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "out_of_scope_reason": {
      "type": "string",
      "minLength": 1
    }
  }
}
